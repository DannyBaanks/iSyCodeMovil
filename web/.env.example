# Copia este archivo a .env y llena lo que vayas a usar. Nada de esto se sube a git.

# Gemini (el asistente del panel). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar. Si Google lo retira, cámbialo aquí; el panel muestra el error tal cual.
GEMINI_MODEL=gemini-2.5-flash

# Inicio de sesión con Google (Gmail, Calendar, Drive…). Crea un cliente OAuth tipo "App de escritorio"
# en https://console.cloud.google.com/apis/credentials y habilita las APIs que vayas a usar.
ISY_GOOGLE_CLIENT_ID=
ISY_GOOGLE_CLIENT_SECRET=

# Puerto del panel (solo escucha en 127.0.0.1).
PORT=3000
